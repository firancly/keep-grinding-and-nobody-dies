use std::time::Instant;

use rand::RngExt;

use super::{register_mistake, solve_current_module, GameState, PendingAction};
use crate::esp_io::{ButtonEdge, EdgeKind, IoSnapshot};

/// Simplified Button module:
/// - one physical button is selected
/// - the screen says TAP or HOLD
/// - TAP: release before hold_threshold_ms
/// - HOLD: keep holding until READY appears, then release
#[derive(Debug, Clone, Default)]
pub struct ButtonState {
    pub active_slot: u8,
    /// 0 = TAP, 1 = HOLD
    pub virtual_label: u8,
    /// Kept for the existing view protocol:
    /// TAP is blue, HOLD is yellow.
    pub virtual_color: u8,
    pub rule_says_hold: bool,
    pub is_down: bool,
    pub pressed_at_esp_ms: Option<u32>,
    /// For HOLD, this becomes true once it is safe to release.
    pub strip_visible: bool,
    /// No longer random or rule-bearing; retained for protocol compatibility.
    pub strip_color: u8,
}

pub fn start(state: &mut GameState) {
    let mut rng = rand::rng();

    state.button.active_slot = rng.random_range(0..4);
    state.button.virtual_label = rng.random_range(0..2);
    state.button.rule_says_hold = state.button.virtual_label == 1;

    // Blue = TAP, yellow = HOLD.
    state.button.virtual_color = if state.button.rule_says_hold { 2 } else { 0 };

    state.button.is_down = false;
    state.button.pressed_at_esp_ms = None;
    state.button.strip_visible = false;
    state.button.strip_color = state.button.virtual_color;

    state.status_title = "THE BUTTON".to_string();
    state.status_detail = if state.button.rule_says_hold {
        "Hold the shown button until READY appears".to_string()
    } else {
        "Tap the shown button quickly".to_string()
    };
}

pub fn retry(state: &mut GameState) {
    state.button.is_down = false;
    state.button.pressed_at_esp_ms = None;
    state.button.strip_visible = false;

    state.status_title = "THE BUTTON".to_string();
    state.status_detail = if state.button.rule_says_hold {
        "Second chance: hold until READY, then release".to_string()
    } else {
        "Second chance: tap and release quickly".to_string()
    };
}

pub fn on_edge(state: &mut GameState, edge: &ButtonEdge, now: Instant) {
    let active_slot = state.button.active_slot;

    if edge.button != active_slot {
        if edge.kind == EdgeKind::Press {
            register_mistake(
                state,
                "Wrong physical button",
                PendingAction::ButtonRetry,
                now,
            );
        }
        return;
    }

    match edge.kind {
        EdgeKind::Press => {
            state.button.is_down = true;
            state.button.pressed_at_esp_ms = Some(edge.t_ms);
            state.button.strip_visible = false;

            state.status_detail = if state.button.rule_says_hold {
                "Keep holding…".to_string()
            } else {
                "Release quickly".to_string()
            };
        }
        EdgeKind::Release => {
            if !state.button.is_down {
                return;
            }

            let pressed_at = state.button.pressed_at_esp_ms.unwrap_or(edge.t_ms);
            let held_for = edge.t_ms.wrapping_sub(pressed_at);
            let threshold = crate::config::get().game.hold_threshold_ms;

            state.button.is_down = false;

            if state.button.rule_says_hold {
                if held_for >= threshold {
                    solve_current_module(state, now);
                } else {
                    register_mistake(
                        state,
                        "Released the HOLD button too early",
                        PendingAction::ButtonRetry,
                        now,
                    );
                }
            } else if held_for < threshold {
                solve_current_module(state, now);
            } else {
                register_mistake(
                    state,
                    "The TAP button was held too long",
                    PendingAction::ButtonRetry,
                    now,
                );
            }
        }
    }
}

pub fn on_tick(state: &mut GameState, io: &IoSnapshot) {
    if !state.button.rule_says_hold
        || !state.button.is_down
        || state.button.strip_visible
    {
        return;
    }

    let active_slot = state.button.active_slot as usize;

    if !io
        .buttons_stable
        .get(active_slot)
        .copied()
        .unwrap_or(false)
    {
        return;
    }

    if let Some(pressed_at) = state.button.pressed_at_esp_ms {
        if io.esp_millis.wrapping_sub(pressed_at)
            >= crate::config::get().game.hold_threshold_ms
        {
            state.button.strip_visible = true;
            state.status_detail = "READY — release now".to_string();
        }
    }
}
