<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"
    />
    <title>Keep Grinding — Defuser</title>
    <style>
      :root {
        --bg: #191632;
        --casing: #0e0c1e;
        --panel: #171233;
        --panel-2: #1e1840;
        --edge: #2c2555;
        --edge-hot: #4a3f86;
        --ink: #ece9f7;
        --muted: #8a85b8;
        --gold: #c9a24b;
        --danger: #e5484d;
        --ok: #34d17a;
        --wire-blue: #4c8dff;
        --wire-white: #e7e5f2;
        --wire-yellow: #f2c53d;
        --wire-red: #e5484d;
        --wire-green: #34d17a;
      }
      * {
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
      }
      html,
      body {
        height: 100%;
        margin: 0;
        overflow: hidden;
        background: radial-gradient(
          circle at 50% 0%,
          #221c45 0%,
          var(--bg) 55%
        );
        color: var(--ink);
        font-family: "Segoe UI", system-ui, sans-serif;
        user-select: none;
      }

      /* ---- Fullscreen gate ------------------------------------------------- */
      .fullscreen-gate {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg);
      }
      .fullscreen-gate.hidden {
        display: none;
      }
      .gate-content {
        text-align: center;
        padding: 24px;
      }
      .gate-title {
        font-size: clamp(24px, 6vw, 40px);
        font-weight: 900;
        letter-spacing: 2px;
        line-height: 1.25;
        margin-bottom: 32px;
        color: var(--gold);
        text-shadow: 0 0 24px rgba(201, 162, 75, 0.4);
      }
      .enter-btn {
        font-size: clamp(18px, 4vw, 26px);
        font-weight: 900;
        letter-spacing: 3px;
        padding: 22px 48px;
        border-radius: 16px;
        border: 2px solid var(--gold);
        background: linear-gradient(180deg, var(--panel-2), var(--panel));
        color: var(--gold);
        box-shadow: 0 0 30px rgba(201, 162, 75, 0.25);
        cursor: pointer;
      }
      .enter-btn:active {
        transform: translateY(2px);
      }
      .gate-hint {
        margin-top: 20px;
        color: var(--muted);
        font-size: 13px;
        letter-spacing: 1px;
      }

      /* ---- Layout ------------------------------------------------------------ */
      .defuser {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(8px, 2vw, 24px);
      }
      .casing {
        width: 100%;
        height: 100%;
        max-width: 1400px;
        background: linear-gradient(180deg, var(--casing), #0a0817);
        border: 2px solid var(--edge);
        border-radius: 20px;
        box-shadow:
          0 0 0 6px #060512,
          0 30px 80px rgba(0, 0, 0, 0.6),
          inset 0 1px 0 rgba(255, 255, 255, 0.04);
        padding: clamp(10px, 2vw, 22px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .status-bar {
        display: flex;
        align-items: center;
        gap: clamp(10px, 2vw, 22px);
        flex-wrap: wrap;
        padding: 6px 10px 14px;
        border-bottom: 1px dashed var(--edge);
        margin-bottom: 14px;
        flex-shrink: 0;
      }
      .timer {
        font-family: "Courier New", monospace;
        font-size: clamp(38px, 6.5vw, 62px);
        line-height: 1;
        letter-spacing: 2px;
        color: var(--gold);
        text-shadow: 0 0 18px rgba(201, 162, 75, 0.35);
        min-width: 130px;
        font-weight: 900;
      }
      .timer.is-low {
        color: var(--danger);
        text-shadow: 0 0 18px rgba(229, 72, 77, 0.5);
        animation: blink 1s steps(2, start) infinite;
      }
      @keyframes blink {
        50% {
          opacity: 0.35;
        }
      }

      .strikes {
        display: flex;
        gap: 6px;
        font-size: clamp(16px, 2.5vw, 22px);
      }
      .strike {
        color: var(--edge-hot);
      }
      .strike.is-hit {
        color: var(--danger);
        text-shadow: 0 0 10px rgba(229, 72, 77, 0.6);
      }

      .badges {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-left: auto;
      }
      .badge {
        font-size: clamp(10px, 1.6vw, 12px);
        letter-spacing: 0.5px;
        color: var(--muted);
        background: var(--panel);
        border: 1px solid var(--edge);
        border-radius: 999px;
        padding: 5px 11px;
        white-space: nowrap;
      }
      .badge.is-lit {
        color: var(--ok);
        border-color: rgba(52, 209, 122, 0.5);
        box-shadow: 0 0 10px rgba(52, 209, 122, 0.25);
      }

      /* One-line game feedback from the engine (SECOND CHANCE, MODULE
         SOLVED, what to do next...) - the only place mistakes get
         explained, so it sits right under the timer where eyes already are. */
      .status-line {
        display: none;
        text-align: center;
        padding: 8px 12px;
        margin-bottom: 12px;
        border: 1px solid var(--edge);
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.25);
        flex-shrink: 0;
      }
      .status-line.show {
        display: block;
      }
      .status-title {
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 2px;
        color: var(--gold);
      }
      .status-detail {
        margin-top: 3px;
        font-size: 12px;
        letter-spacing: 0.5px;
        color: var(--muted);
      }
      .status-line.is-alert {
        border-color: rgba(229, 72, 77, 0.6);
        box-shadow: 0 0 18px rgba(229, 72, 77, 0.25);
      }
      .status-line.is-alert .status-title {
        color: var(--danger);
      }
      .status-line.is-good {
        border-color: rgba(52, 209, 122, 0.55);
        box-shadow: 0 0 18px rgba(52, 209, 122, 0.2);
      }
      .status-line.is-good .status-title {
        color: var(--ok);
      }

      .module-grid {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        overflow-y: auto;
        padding: 4px 0;
      }
      .module-stepper {
        display: flex;
        justify-content: center;
        gap: clamp(14px, 3vw, 28px);
        flex-wrap: wrap;
      }
      .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        opacity: 0.4;
      }
      .step-dot {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--edge);
        font-size: 13px;
        font-weight: 700;
        color: var(--muted);
      }
      .step-label {
        font-size: 10px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--muted);
      }
      .step-done {
        opacity: 0.7;
      }
      .step-done .step-dot {
        border-color: var(--ok);
        color: var(--ok);
        background: rgba(52, 209, 122, 0.12);
      }
      .step-current {
        opacity: 1;
      }
      .step-current .step-dot {
        border-color: var(--gold);
        color: var(--gold);
        box-shadow: 0 0 16px rgba(201, 162, 75, 0.4);
      }
      .step-current .step-label {
        color: var(--gold);
      }
      .module-card {
        background: linear-gradient(180deg, var(--panel), var(--panel-2));
        border: 1px solid var(--edge);
        border-radius: 14px;
        padding: 14px;
        min-height: 180px;
        width: min(520px, 100%);
        display: flex;
        flex-direction: column;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
      }
      .module-card.is-solved {
        border-color: rgba(52, 209, 122, 0.5);
        box-shadow: 0 0 22px rgba(52, 209, 122, 0.18);
      }
      .module-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 12px;
      }
      .module-title {
        font-size: 18px;
        font-weight: 900;
        letter-spacing: 0.5px;
      }
      .module-status {
        font-size: 10px;
        letter-spacing: 1.5px;
        color: var(--muted);
      }
      .is-solved .module-status {
        color: var(--ok);
      }
      .module-body {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* ---- Wires -------------------------------------------------------------- */
      .wire-list {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .wire-armed {
        font-size: 11px;
        letter-spacing: 0.5px;
        color: var(--muted);
        text-transform: uppercase;
        margin-bottom: 4px;
      }
      .wire-armed.is-armed {
        color: var(--ok);
      }
      .wire-row {
        display: grid;
        grid-template-columns: 20px 1fr 54px;
        align-items: center;
        gap: 10px;
      }
      .wire-index {
        color: var(--muted);
        font-size: 12px;
        text-align: center;
      }
      .wire {
        position: relative;
        height: 10px;
        border-radius: 6px;
      }
      .wire-line {
        position: absolute;
        inset: 0;
        border-radius: 6px;
        background: var(--wire-white);
        box-shadow: 0 0 10px var(--wire-white);
      }
      .wire-gap {
        position: absolute;
        left: 50%;
        top: -3px;
        width: 14px;
        height: 16px;
        transform: translateX(-50%) skewX(-18deg);
        background: var(--panel-2);
      }
      .wire-status {
        font-size: 11px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .wire-row.is-cut .wire-line {
        opacity: 0.28;
        box-shadow: none;
      }
      .wire-row.is-cut .wire-status {
        text-decoration: line-through;
        opacity: 0.5;
      }
      .alien-box {
        margin-top: 10px;
        padding: 10px;
        border: 1px dashed var(--edge-hot);
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.2);
        text-align: center;
      }
      .alien-phrase {
        font-family: "Courier New", monospace;
        font-size: 16px;
        letter-spacing: 2px;
        color: var(--gold);
      }
      .alien-class {
        margin-top: 4px;
        font-size: 10px;
        letter-spacing: 1px;
        color: var(--muted);
        text-transform: uppercase;
      }

      /* ---- Simon ---------------------------------------------------------------- */
      .simon {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
      }
      .simon-pads {
        display: grid;
        grid-template-columns: repeat(2, 46px);
        grid-auto-rows: 46px;
        gap: 8px;
      }
      .simon-pad {
        border-radius: 10px;
        background: var(--c);
        opacity: 0.32;
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.3);
        transition:
          opacity 0.08s,
          box-shadow 0.08s,
          transform 0.08s;
      }
      .simon-pad.red {
        --c: var(--wire-red);
      }
      .simon-pad.blue {
        --c: var(--wire-blue);
      }
      .simon-pad.green {
        --c: var(--wire-green);
      }
      .simon-pad.yellow {
        --c: var(--wire-yellow);
      }
      .simon-pad.is-lit {
        opacity: 1;
        transform: scale(1.05);
        box-shadow: 0 0 22px var(--c);
      }
      .simon-phase {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--muted);
      }
      .simon-phase.is-input {
        color: var(--ok);
        text-shadow: 0 0 12px rgba(52, 209, 122, 0.5);
        animation: inputPulse 1s ease-in-out infinite;
      }
      @keyframes inputPulse {
        50% {
          opacity: 0.55;
        }
      }
      .simon-progress {
        display: flex;
        gap: 6px;
      }
      .pip {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--edge);
      }
      .pip.is-done {
        background: var(--ok);
        box-shadow: 0 0 8px rgba(52, 209, 122, 0.6);
      }

      /* ---- Memory ----------------------------------------------------------------- */
      .memory {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
      }
      .memory-stage {
        font-size: 10px;
        letter-spacing: 1.5px;
        color: var(--muted);
        text-transform: uppercase;
      }
      .memory-display {
        font-family: "Courier New", monospace;
        font-size: 46px;
        color: var(--gold);
        text-shadow: 0 0 18px rgba(201, 162, 75, 0.35);
        line-height: 1;
      }
      .memory-slots {
        display: flex;
        gap: 8px;
      }
      .memory-slot {
        width: 42px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 6px 0;
        border-radius: 8px;
        background: #0c0a1c;
        border: 1px solid var(--edge);
      }
      .memory-slot-index {
        font-size: 8px;
        letter-spacing: 0.5px;
        color: var(--muted);
      }
      .memory-slot-label {
        font-family: "Courier New", monospace;
        font-size: 20px;
      }

      /* ---- Hold ----------------------------------------------------------------- */
      .hold {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }
      .hold-slot-indicator {
        font-size: 10px;
        letter-spacing: 1px;
        color: var(--muted);
        text-transform: uppercase;
      }
      .hold-btn {
        width: 108px;
        height: 60px;
        border: none;
        border-radius: 12px;
        font-weight: 900;
        font-size: 18px;
        letter-spacing: 1px;
        color: #0a0817;
        background: var(--c);
        box-shadow:
          0 6px 0 rgba(0, 0, 0, 0.4),
          0 0 22px var(--c);
      }
      .hold-btn.blue {
        --c: var(--wire-blue);
      }
      .hold-btn.white {
        --c: var(--wire-white);
      }
      .hold-btn.yellow {
        --c: var(--wire-yellow);
      }
      .hold-btn.red {
        --c: var(--wire-red);
      }
      .hold-btn.is-holding {
        transform: translateY(4px);
        box-shadow:
          0 2px 0 rgba(0, 0, 0, 0.4),
          0 0 30px var(--c);
      }
      .hold-status {
        font-size: 11px;
        letter-spacing: 1px;
        color: var(--muted);
        text-transform: uppercase;
      }
      .hold-strip {
        margin-top: 4px;
        padding: 6px 12px;
        border: 1px dashed var(--c);
        border-radius: 8px;
        font-size: 11px;
        letter-spacing: 1px;
        color: var(--c);
      }
      .hold-strip.blue {
        --c: var(--wire-blue);
      }
      .hold-strip.white {
        --c: var(--wire-white);
      }
      .hold-strip.yellow {
        --c: var(--wire-yellow);
      }
      .hold-strip.red {
        --c: var(--wire-red);
      }

      /* ---- Waiting / result screens ------------------------------------------- */
      .waiting-screen,
      .result-screen {
        flex: 1;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 12px;
      }
      .waiting-screen.show,
      .result-screen.show {
        display: flex;
      }
      .waiting-screen p {
        font-size: clamp(20px, 4vw, 30px);
        letter-spacing: 1px;
        color: var(--muted);
      }
      .result-title {
        font-size: clamp(48px, 12vw, 110px);
        font-weight: 900;
        letter-spacing: 4px;
      }
      .result-screen.defused .result-title {
        color: var(--ok);
        text-shadow: 0 0 40px rgba(52, 209, 122, 0.5);
      }
      .result-screen.exploded .result-title {
        color: var(--danger);
        text-shadow: 0 0 40px rgba(229, 72, 77, 0.5);
      }
      .result-detail {
        color: var(--muted);
        font-size: 16px;
      }

      /* ---- Events (whole-screen) ------------------------------------------------ */
      /* Note: these classes land on #shell itself (which already has class
   "casing"), not a wrapper around it - so they must target the element
   directly rather than "X .casing" (a descendant selector would never
   match here). */
      .upside {
        transform: rotate(180deg);
      }
      .turk {
        animation: drunk 0.18s infinite alternate;
      }
      .mirror {
        transform: scaleX(-1);
      }
      .siren {
        animation: sirenFlash 0.5s infinite;
      }
      .dyslexia .module-title,
      .dyslexia .wire-status,
      .dyslexia .badge {
        display: inline-block;
      }
      @keyframes drunk {
        from {
          transform: translate(-6px, 4px) rotate(-0.7deg);
        }
        to {
          transform: translate(7px, -3px) rotate(0.8deg);
        }
      }
      @keyframes sirenFlash {
        0%,
        100% {
          box-shadow:
            0 0 0 6px #060512,
            0 0 100px 16px rgba(229, 72, 77, 0.55);
        }
        50% {
          box-shadow:
            0 0 0 6px #060512,
            0 0 100px 16px rgba(76, 141, 255, 0.55);
        }
      }
      .event-banner {
        display: none;
        position: fixed;
        left: 50%;
        top: 14px;
        transform: translateX(-50%);
        z-index: 950;
        background: var(--gold);
        color: #0a0817;
        border-radius: 999px;
        padding: 8px 20px;
        font-weight: 900;
        letter-spacing: 2px;
        font-size: 13px;
      }
      .event-banner.show {
        display: block;
      }

      .overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1000;
      }
      .overlay.show {
        display: flex;
      }
      .bsod {
        background: #0647a8;
        color: #fff;
        padding: 8vw;
        align-items: flex-start;
        justify-content: center;
        flex-direction: column;
        font-family: ui-monospace, monospace;
      }
      .bsod .face {
        font-size: 70px;
      }
      .bsod p {
        max-width: 620px;
        font-size: clamp(14px, 2.5vw, 20px);
      }
      .bsod-pct {
        opacity: 0.85;
      }

      .jumpscare {
        background: #020204;
        align-items: center;
        justify-content: center;
        animation: flashBg 0.1s infinite;
      }
      .jumpscare-video {
        background: #000;
      }
      .jumpscare-video video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .monster {
        width: min(430px, 70vw);
        aspect-ratio: 1;
        border-radius: 42% 48% 39% 45%;
        background: linear-gradient(#384455, #101620);
        border: 12px solid #7f96aa;
        position: relative;
        box-shadow: 0 0 90px #b8dcff;
      }
      .eye {
        position: absolute;
        top: 27%;
        width: 24%;
        height: 22%;
        border-radius: 50%;
        background: white;
        box-shadow: 0 0 35px white;
      }
      .eye.left {
        left: 16%;
      }
      .eye.right {
        right: 16%;
      }
      .pupil {
        position: absolute;
        inset: 30%;
        border-radius: 50%;
        background: #020204;
      }
      .mouth {
        position: absolute;
        left: 14%;
        right: 14%;
        bottom: 15%;
        height: 25%;
        background: #020204;
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 3px;
        padding: 8px;
      }
      .tooth {
        background: white;
        clip-path: polygon(50% 100%, 0 0, 100% 0);
      }
      @keyframes flashBg {
        0% {
          filter: invert(0);
        }
        50% {
          filter: invert(1);
        }
        100% {
          filter: invert(0);
        }
      }

      /* ---- Stimulation corner (muted brainrot feed, config-driven) ------ */
      .stim-corner {
        display: none;
        position: fixed;
        right: 12px;
        bottom: 12px;
        z-index: 900; /* under event overlays (950+), above the casing */
        width: clamp(150px, 20vw, 240px);
        aspect-ratio: 9 / 16;
        overflow: hidden;
        pointer-events: none; /* never intercepts a defuser's tap */
        background: #000;
      }
      .stim-corner.show {
        display: block;
      }
      .stim-feed {
        height: 100%;
        transition: transform 0.45s cubic-bezier(0.6, 0, 0.2, 1);
      }
      .stim-feed video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .stim-label {
        position: absolute;
        left: 8px;
        bottom: 8px;
        z-index: 2;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 1.5px;
        color: #fff;
        text-shadow: 1px 1px 0 #000;
        text-transform: uppercase;
        opacity: 0.85;
      }
      .stim-ui {
        position: absolute;
        right: 6px;
        bottom: 24px;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-size: 16px;
        filter: drop-shadow(1px 1px 0 #000);
      }

      .static-noise {
        background: repeating-linear-gradient(
          0deg,
          #111 0px,
          #111 2px,
          #333 2px,
          #333 4px
        );
        align-items: center;
        justify-content: center;
        animation: staticFlicker 0.08s infinite;
      }
      .static-noise span {
        font-size: clamp(28px, 6vw, 60px);
        font-weight: 900;
        letter-spacing: 4px;
        color: #fff;
        text-shadow: 2px 2px 0 #000;
      }
      @keyframes staticFlicker {
        0% {
          filter: brightness(1) contrast(1);
        }
        50% {
          filter: brightness(1.4) contrast(1.3);
        }
        100% {
          filter: brightness(0.9) contrast(1);
        }
      }
    </style>
  


<!-- HANDMADE_PIXEL_THEME_START -->
<style id="handmade-pixel-theme">
/* Injected after the original tablet styles. Presentation only. */

:root {
  --craft-night: #111827;
  --craft-paper: #f4edda;
  --craft-paper-deep: #ddd2b7;
  --craft-light: #fffaf0;

  --craft-ink: #20252b;
  --craft-muted: #6e777f;
  --craft-blue: #4868c7;
  --craft-red: #d95a4e;

  --craft-yellow: #d5aa35;
  --craft-green: #4c9a70;
  --craft-pink: #d67b9a;
  --craft-tape: #efce82;

  --bg: var(--craft-night);
  --casing: var(--craft-paper);
  --panel: var(--craft-paper);
  --panel-2: var(--craft-light);

  --edge: var(--craft-ink);
  --edge-hot: var(--craft-blue);
  --ink: var(--craft-ink);
  --muted: var(--craft-muted);

  --gold: var(--craft-yellow);
  --danger: var(--craft-red);
  --ok: var(--craft-green);
}

html,
body {
  background-color: var(--craft-night);

  background-image:
    linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
    repeating-linear-gradient(
      135deg,
      transparent 0 25px,
      rgba(72, 104, 199, 0.06) 25px 27px
    );

  background-size:
    16px 16px,
    16px 16px,
    auto;
  color: var(--craft-ink);
  font-family: "Trebuchet MS", "Arial Narrow", Arial, sans-serif;
  image-rendering: pixelated;
}

.fullscreen-gate {
  background:
    linear-gradient(rgba(32, 37, 43, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(32, 37, 43, 0.045) 1px, transparent 1px),
    var(--craft-paper);
  background-size: 18px 18px;
  color: var(--craft-ink);
}

.gate-content {
  position: relative;
  width: min(680px, 88vw);
  padding: clamp(24px, 6vw, 56px);
  background: var(--craft-light);
  border: 4px solid var(--craft-ink);
  border-radius: 0;

  box-shadow:
    8px 8px 0 var(--craft-ink),
    16px 16px 0 rgba(0, 0, 0, 0.16);

  clip-path: polygon(
    0 8px,
    8px 8px,
    8px 0,
    calc(100% - 14px) 0,
    calc(100% - 14px) 7px,
    100% 7px,
    100% 100%,
    12px 100%,
    12px calc(100% - 7px),
    0 calc(100% - 7px)
  );
  transform: rotate(-0.3deg);
}

.gate-content::before,
.gate-content::after {
  content: "";
  position: absolute;
  width: 86px;
  height: 23px;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.2) 0 5px,
      rgba(0, 0, 0, 0.04) 5px 7px
    ),
    var(--craft-tape);
  border: 2px solid rgba(32, 37, 43, 0.2);
}

.gate-content::before {
  top: -12px;
  left: 10%;
  transform: rotate(-4deg);
}
.gate-content::after {
  right: 8%;
  bottom: -10px;
  transform: rotate(3deg);
}

.gate-title {
  color: var(--craft-blue);
  text-shadow: 4px 4px 0 var(--craft-yellow);
  font-family: "Arial Black", Impact, sans-serif;
  font-size: clamp(29px, 7vw, 58px);
  line-height: 0.95;
  letter-spacing: -0.045em;
}

.enter-btn {
  padding: 17px 34px;
  color: var(--craft-light);
  background: var(--craft-red);
  border: 4px solid var(--craft-ink);
  border-radius: 0;
  box-shadow: 6px 6px 0 var(--craft-ink);
  font:
    900 clamp(16px, 3.2vw, 25px)/1 ui-monospace,
    "Courier New",
    monospace;
  letter-spacing: 0.08em;
  transform: rotate(0.5deg);
}

.enter-btn:active {
  transform: translate(5px, 5px) rotate(0.5deg);
  box-shadow: 1px 1px 0 var(--craft-ink);
}
.gate-hint {
  color: var(--craft-muted);
  font-family: ui-monospace, "Courier New", monospace;
}

.defuser {
  padding: clamp(6px, 1.4vw, 15px);
}

.casing {
  max-width: 1450px;
  padding: clamp(9px, 1.6vw, 18px);
  color: var(--craft-ink);

  background:
    linear-gradient(90deg, rgba(32, 37, 43, 0.035) 1px, transparent 1px),
    linear-gradient(rgba(32, 37, 43, 0.035) 1px, transparent 1px),
    var(--craft-paper);
  background-size: 18px 18px;

  border: 4px solid var(--craft-ink);
  border-radius: 0;
  box-shadow:
    7px 7px 0 #060a10,
    14px 14px 0 rgba(0, 0, 0, 0.22);

  clip-path: polygon(
    0 8px,
    8px 8px,
    8px 0,
    calc(100% - 18px) 0,
    calc(100% - 18px) 6px,
    100% 6px,
    100% calc(100% - 12px),
    calc(100% - 8px) calc(100% - 12px),
    calc(100% - 8px) 100%,
    14px 100%,
    14px calc(100% - 6px),
    0 calc(100% - 6px)
  );
}

.casing::before,
.casing::after {
  content: "";
  position: absolute;
  z-index: 5;
  width: 76px;
  height: 18px;
  pointer-events: none;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.18) 0 4px,
      rgba(0, 0, 0, 0.04) 4px 6px
    ),
    var(--craft-tape);
  border: 2px solid rgba(32, 37, 43, 0.18);
}

.casing::before {
  left: 8%;
  top: -7px;
  transform: rotate(-2.5deg);
}
.casing::after {
  right: 8%;
  bottom: -6px;
  transform: rotate(2deg);
}

.status-bar {
  display: grid;
  grid-template-columns: auto auto 1fr;
  align-items: center;
  gap: clamp(8px, 1.7vw, 18px);
  padding: 6px 8px 13px;
  margin-bottom: 10px;
  border-bottom: 4px dashed var(--craft-ink);
}

.timer {
  min-width: 145px;
  padding: 7px 11px 5px;
  color: var(--craft-light);
  background: var(--craft-ink);
  border: 4px solid var(--craft-ink);
  box-shadow:
    inset 0 0 0 3px var(--craft-blue),
    5px 5px 0 var(--craft-blue);
  font:
    900 clamp(38px, 6.1vw, 62px)/0.9 ui-monospace,
    "Courier New",
    monospace;
  letter-spacing: -0.08em;
  text-shadow: none;
  transform: rotate(-0.4deg);
}

.timer.is-low {
  color: #fff4d8;
  text-shadow: none;
  box-shadow:
    inset 0 0 0 3px var(--craft-red),
    5px 5px 0 var(--craft-red);
}

.strikes {
  gap: 5px;
  padding: 5px 7px;
  background: var(--craft-light);
  border: 3px solid var(--craft-ink);
  box-shadow: 3px 3px 0 var(--craft-ink);
}

.strike {
  display: grid;
  place-items: center;
  width: 24px;
  height: 24px;
  color: var(--craft-paper-deep);
  border: 2px dashed var(--craft-muted);
  font:
    900 17px/1 ui-monospace,
    monospace;
}
.strike.is-hit {
  color: var(--craft-light);
  background: var(--craft-red);
  border-color: var(--craft-ink);
  text-shadow: none;
  transform: rotate(-7deg);
}

.badges {
  justify-content: flex-end;
  gap: 6px;
}
.badge {
  padding: 5px 8px;
  color: var(--craft-ink);
  background: var(--craft-light);
  border: 3px solid var(--craft-ink);
  border-radius: 0;
  box-shadow: 3px 3px 0 var(--craft-ink);
  font:
    900 clamp(9px, 1.3vw, 12px)/1 ui-monospace,
    "Courier New",
    monospace;
  letter-spacing: 0.02em;
}

.badge:nth-child(1) {
  background: #dce8f7;
  transform: rotate(-0.5deg);
}
.badge:nth-child(2) {
  background: #f7e4b8;
  transform: rotate(0.4deg);
}
.badge:nth-child(3) {
  background: #eadce5;
  transform: rotate(-0.3deg);
}
.badge:nth-child(4) {
  background: #dcebdd;
  transform: rotate(0.55deg);
}

.badge.is-lit {
  color: var(--craft-light);
  background: var(--craft-green);
  border-color: var(--craft-ink);
  box-shadow: 3px 3px 0 var(--craft-ink);
}

.module-grid {
  gap: 10px;
  padding: 3px 0 7px;
}
.module-stepper {
  gap: clamp(14px, 2.8vw, 32px);
  flex-wrap: nowrap;
  padding: 2px 0 3px;
}

.step {
  gap: 5px;
  opacity: 0.38;
  position: relative;
}
.step::after {
  content: "";
  position: absolute;
  left: calc(100% + 5px);
  top: 14px;
  width: clamp(8px, 2vw, 23px);
  border-top: 3px dashed var(--craft-ink);
  opacity: 0.32;
}
.step:last-child::after {
  display: none;
}

.step-dot {
  width: 29px;
  height: 29px;
  display: block;
  color: transparent;
  font-size: 0;
  border: 4px solid var(--craft-ink);
  border-radius: 50%;
  background: var(--craft-light);
  box-shadow: 3px 3px 0 var(--craft-ink);
}

.step-dot::after {
  content: "";
  display: block;
  width: 9px;
  height: 9px;
  margin: 6px;
  border-radius: 50%;
}
.step-label {
  color: var(--craft-muted);
  font:
    900 9px/1 ui-monospace,
    "Courier New",
    monospace;
  letter-spacing: 0.06em;
}

.step-done,
.step-current {
  opacity: 1;
}
.step-done .step-dot {
  background: var(--craft-green);
}
.step-done .step-dot::after {
  background: var(--craft-light);
}
.step-current .step-dot {
  background: var(--craft-yellow);
  animation: craftCurrent 0.8s steps(2, end) infinite;
}
.step-current .step-dot::after {
  background: var(--craft-red);
}
.step-current .step-label {
  color: var(--craft-ink);
}

@keyframes craftCurrent {
  50% {
    transform: translateY(-2px);
  }
}

.module-card {
  position: relative;
  width: min(620px, 100%);
  min-height: 180px;
  padding: 15px;
  color: var(--craft-ink);

  background:
    repeating-linear-gradient(
      0deg,
      transparent 0 25px,
      rgba(72, 104, 199, 0.1) 25px 27px
    ),
    var(--craft-light);

  border: 4px solid var(--craft-ink);
  border-radius: 0;
  box-shadow: 7px 7px 0 var(--craft-ink);

  clip-path: polygon(
    0 0,
    calc(100% - 9px) 0,
    calc(100% - 9px) 6px,
    100% 6px,
    100% 100%,
    7px 100%,
    7px calc(100% - 7px),
    0 calc(100% - 7px)
  );
  transform: rotate(0.08deg);
}

.module-card::before {
  content: "";
  position: absolute;
  top: -8px;
  left: 12%;
  width: 70px;
  height: 17px;
  background: var(--craft-tape);
  border: 2px solid rgba(32, 37, 43, 0.18);
  transform: rotate(-2deg);
}

.module-card.is-solved {
  border-color: var(--craft-ink);
  box-shadow: 7px 7px 0 var(--craft-green);
}

.module-head {
  align-items: center;
  margin-bottom: 11px;
  padding-bottom: 8px;
  border-bottom: 3px dashed var(--craft-ink);
}

.module-title {
  color: var(--craft-blue);
  font:
    950 clamp(18px, 2.8vw, 27px)/1 "Arial Black",
    Impact,
    sans-serif;
  letter-spacing: -0.035em;
  text-transform: uppercase;
  text-shadow: 2px 2px 0 rgba(213, 170, 53, 0.42);
}

.module-status {
  padding: 4px 6px;
  color: var(--craft-light);
  background: var(--craft-red);
  border: 2px solid var(--craft-ink);
  font:
    900 9px/1 ui-monospace,
    monospace;
}
.is-solved .module-status {
  color: var(--craft-light);
  background: var(--craft-green);
}

.wire-list {
  gap: 9px;
}
.wire-armed,
.hold-slot-indicator,
.hold-status {
  color: var(--craft-muted);
  font:
    900 10px/1 ui-monospace,
    monospace;
}
.wire-armed.is-armed {
  color: var(--craft-green);
}

.wire-row {
  grid-template-columns: 24px 1fr 62px;
  gap: 9px;
  padding: 4px 5px;
  background: rgba(255, 255, 255, 0.43);
  border-left: 4px solid var(--craft-paper-deep);
}

.wire-index,
.wire-status {
  color: var(--craft-muted);
  font-family: ui-monospace, monospace;
  font-weight: 900;
}
.wire {
  height: 12px;
  border-radius: 0;
}
.wire-line {
  border-radius: 0;
  background: repeating-linear-gradient(
    90deg,
    var(--wire-white) 0 8px,
    #b7b1a6 8px 11px
  );
  border: 2px solid var(--craft-ink);
  box-shadow: 3px 3px 0 rgba(32, 37, 43, 0.28);
}

.wire-gap {
  top: -5px;
  width: 17px;
  height: 22px;
  background: var(--craft-light);
  border-left: 3px solid var(--craft-red);
  border-right: 3px solid var(--craft-red);
}

.alien-box {
  padding: 10px;
  color: var(--craft-light);
  background: var(--craft-ink);
  border: 4px solid var(--craft-ink);
  border-radius: 0;
  box-shadow: 4px 4px 0 var(--craft-blue);
}
.alien-phrase {
  color: #fff1b8;
  font-weight: 900;
  text-shadow: none;
}
.alien-class {
  color: #c9d8ff;
}

.simon {
  gap: 12px;
}
.simon-pads {
  grid-template-columns: repeat(2, 52px);
  grid-auto-rows: 52px;
  gap: 8px;
  transform: rotate(-1deg);
}
.simon-pad {
  border: 4px solid var(--craft-ink);
  border-radius: 0;
  box-shadow: 4px 4px 0 var(--craft-ink);
  clip-path: polygon(
    0 0,
    calc(100% - 7px) 0,
    100% 7px,
    100% 100%,
    7px 100%,
    0 calc(100% - 7px)
  );
  opacity: 0.45;
}
.simon-pad.is-lit {
  opacity: 1;
  transform: translate(-2px, -2px);
  box-shadow: 6px 6px 0 var(--craft-ink);
}

.simon-progress,
.memory-stage {
  display: flex;
  gap: 7px;
  align-items: center;
  justify-content: center;
}
.pip,
.memory-stage-dot {
  width: 14px;
  height: 14px;
  border: 3px solid var(--craft-ink);
  border-radius: 50%;
  background: var(--craft-light);
  box-shadow: 2px 2px 0 var(--craft-ink);
}
.pip.is-done,
.memory-stage-dot.is-done {
  background: var(--craft-green);
}
.memory-stage-dot.is-current {
  background: var(--craft-yellow);
  box-shadow:
    inset 0 0 0 3px var(--craft-red),
    2px 2px 0 var(--craft-ink);
}

.memory {
  gap: 8px;
}
.memory-stage {
  min-height: 18px;
  color: transparent;
  font-size: 0;
}
.memory-display {
  min-width: 74px;
  padding: 5px 10px;
  color: var(--craft-light);
  background: var(--craft-blue);
  border: 4px solid var(--craft-ink);
  box-shadow: 5px 5px 0 var(--craft-yellow);
  font:
    900 48px/0.95 ui-monospace,
    "Courier New",
    monospace;
  text-shadow: none;
  transform: rotate(-0.6deg);
}

.memory-slots {
  gap: 8px;
}
.memory-slot {
  width: 48px;
  padding: 7px 0;
  background: var(--craft-light);
  border: 3px solid var(--craft-ink);
  border-radius: 0;
  box-shadow: 3px 3px 0 var(--craft-ink);
}
.memory-slot:nth-child(2) {
  transform: translateY(2px);
}
.memory-slot:nth-child(4) {
  transform: translateY(-1px);
}
.memory-slot-index {
  color: var(--craft-muted);
  font-family: ui-monospace, monospace;
}
.memory-slot-label {
  font-weight: 900;
}

.hold {
  gap: 10px;
}
.hold-btn {
  width: 122px;
  height: 64px;
  color: var(--craft-ink);
  border: 4px solid var(--craft-ink);
  border-radius: 0;
  box-shadow:
    7px 7px 0 var(--craft-ink),
    inset 0 0 0 3px rgba(255, 255, 255, 0.25);
  clip-path: polygon(
    0 0,
    calc(100% - 8px) 0,
    100% 8px,
    100% 100%,
    8px 100%,
    0 calc(100% - 8px)
  );
}
.hold-btn.is-holding {
  transform: translate(5px, 5px);
  box-shadow:
    2px 2px 0 var(--craft-ink),
    inset 0 0 0 3px rgba(255, 255, 255, 0.25);
}

.hold-strip {
  padding: 7px 11px;
  color: var(--craft-ink);
  background: var(--craft-light);
  border: 3px dashed var(--c);
  border-radius: 0;
  box-shadow: 3px 3px 0 var(--craft-ink);
}

.waiting-screen p,
.result-screen {
  color: var(--craft-ink);
}
.waiting-screen p {
  padding: 22px 30px;
  background: var(--craft-light);
  border: 4px solid var(--craft-ink);
  box-shadow: 7px 7px 0 var(--craft-ink);
  font:
    900 clamp(18px, 3.5vw, 30px)/1.2 ui-monospace,
    monospace;
  transform: rotate(-0.5deg);
}

.result-title {
  font-family: "Arial Black", Impact, sans-serif;
  text-shadow: 5px 5px 0 var(--craft-ink) !important;
}
.result-screen.defused .result-title {
  color: var(--craft-green);
}
.result-screen.exploded .result-title {
  color: var(--craft-red);
}
.result-detail {
  color: var(--craft-muted);
}

.event-banner {
  color: var(--craft-light);
  background: var(--craft-red);
  border: 4px solid var(--craft-ink);
  border-radius: 0;
  box-shadow: 5px 5px 0 var(--craft-ink);
  font-family: ui-monospace, monospace;
  transform: translateX(-50%) rotate(-0.7deg);
}

@media (orientation: landscape) and (max-height: 500px) {
  .defuser {
    padding: 4px;
  }
  .casing {
    padding: 7px 9px;
    box-shadow: 4px 4px 0 #060a10;
  }
  .casing::before,
  .casing::after {
    width: 54px;
    height: 13px;
  }

  .status-bar {
    grid-template-columns: 128px auto 1fr;
    gap: 7px;
    padding: 3px 4px 7px;
    margin-bottom: 5px;
  }

  .timer {
    min-width: 124px;
    padding: 5px 8px 3px;
    font-size: 39px;
    box-shadow:
      inset 0 0 0 2px var(--craft-blue),
      3px 3px 0 var(--craft-blue);
  }
  .timer.is-low {
    box-shadow:
      inset 0 0 0 2px var(--craft-red),
      3px 3px 0 var(--craft-red);
  }

  .strikes {
    padding: 3px 5px;
  }
  .strike {
    width: 19px;
    height: 19px;
    font-size: 13px;
  }
  .badges {
    gap: 4px;
  }
  .badge {
    padding: 4px 5px;
    border-width: 2px;
    box-shadow: 2px 2px 0 var(--craft-ink);
    font-size: 8px;
  }

  .module-grid {
    display: grid;
    grid-template-columns: 145px minmax(0, 1fr);
    align-items: stretch;
    gap: 8px;
    overflow: hidden;
  }
  .module-stepper {
    height: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-content: center;
    gap: 9px 10px;
    padding: 0;
  }
  .step::after {
    display: none;
  }

  .step-dot {
    width: 23px;
    height: 23px;
    border-width: 3px;
    box-shadow: 2px 2px 0 var(--craft-ink);
  }
  .step-dot::after {
    width: 7px;
    height: 7px;
    margin: 5px;
  }
  .step-label {
    font-size: 7px;
  }

  .module-card {
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 9px 11px;
    box-shadow: 4px 4px 0 var(--craft-ink);
  }
  .module-card::before {
    width: 44px;
    height: 11px;
    top: -5px;
  }
  .module-head {
    margin-bottom: 6px;
    padding-bottom: 5px;
  }
  .module-title {
    font-size: 18px;
  }
  .module-status {
    font-size: 7px;
  }
  .module-body {
    min-height: 0;
  }

  .wire-list {
    gap: 4px;
  }
  .wire-row {
    padding: 2px 4px;
  }
  .alien-box {
    margin-top: 5px;
    padding: 6px;
  }
  .alien-phrase {
    font-size: 12px;
  }

  .simon {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 16px;
  }
  .simon-pads {
    grid-template-columns: repeat(2, 39px);
    grid-auto-rows: 39px;
    gap: 5px;
  }
  .simon-progress {
    max-width: 85px;
    flex-wrap: wrap;
  }

  .memory {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-areas: "stage display" "slots slots";
    align-items: center;
    column-gap: 18px;
  }
  .memory-stage {
    grid-area: stage;
  }
  .memory-display {
    grid-area: display;
    font-size: 39px;
    min-width: 64px;
  }
  .memory-slots {
    grid-area: slots;
  }
  .memory-slot {
    width: 43px;
    padding: 4px 0;
  }

  .hold {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-areas: "indicator button" "status strip";
    align-items: center;
    gap: 7px 14px;
  }
  .hold-slot-indicator {
    grid-area: indicator;
  }
  .hold-btn {
    grid-area: button;
    width: 105px;
    height: 48px;
  }
  .hold-status {
    grid-area: status;
  }
  .hold-strip {
    grid-area: strip;
    margin: 0;
  }

  .waiting-screen p {
    padding: 14px 20px;
    font-size: 16px;
  }
}

@media (max-width: 620px) and (orientation: portrait) {
  .status-bar {
    grid-template-columns: auto auto;
  }
  .badges {
    grid-column: 1/-1;
    justify-content: flex-start;
  }
}

/* ---- Post-theme additions -------------------------------------------
   The engine-feedback status line and Simon's turn indicator were added
   to tablet.html after this theme was authored; these restyle them into
   the same paper/sticker language as the rest. */

.status-line {
  padding: 7px 12px;
  margin-bottom: 10px;
  background: var(--craft-light);
  border: 3px solid var(--craft-ink);
  border-radius: 0;
  box-shadow: 4px 4px 0 var(--craft-ink);
  transform: rotate(-0.25deg);
}
.status-title {
  color: var(--craft-blue);
  font:
    900 12px/1.2 ui-monospace,
    "Courier New",
    monospace;
  letter-spacing: 0.08em;
}
.status-detail {
  margin-top: 2px;
  color: var(--craft-muted);
  font:
    700 11px/1.3 ui-monospace,
    "Courier New",
    monospace;
  letter-spacing: 0.02em;
}
.status-line.is-alert {
  background: #f7ddd6;
  border-color: var(--craft-ink);
  box-shadow: 4px 4px 0 var(--craft-red);
}
.status-line.is-alert .status-title {
  color: var(--craft-red);
}
.status-line.is-good {
  background: #dcebdd;
  border-color: var(--craft-ink);
  box-shadow: 4px 4px 0 var(--craft-green);
}
.status-line.is-good .status-title {
  color: var(--craft-green);
}

.simon-phase {
  color: var(--craft-muted);
  font:
    900 11px/1 ui-monospace,
    "Courier New",
    monospace;
  letter-spacing: 0.06em;
}
.simon-phase.is-input {
  padding: 5px 10px;
  color: var(--craft-light);
  background: var(--craft-green);
  border: 3px solid var(--craft-ink);
  box-shadow: 3px 3px 0 var(--craft-ink);
  text-shadow: none;
  transform: rotate(-1deg);
  animation: craftYourTurn 0.8s steps(2, end) infinite;
}
@keyframes craftYourTurn {
  50% {
    transform: rotate(-1deg) translateY(-2px);
  }
}

.stim-corner {
  border: 4px solid var(--craft-ink);
  box-shadow: 6px 6px 0 var(--craft-ink);
  transform: rotate(0.8deg);
  background: var(--craft-ink);
}
.stim-corner::before {
  content: "";
  position: absolute;
  top: -9px;
  left: 50%;
  z-index: 3;
  width: 58px;
  height: 15px;
  transform: translateX(-50%) rotate(-2.5deg);
  background: var(--craft-tape);
  border: 2px solid rgba(32, 37, 43, 0.18);
}
.stim-label {
  font-family: ui-monospace, "Courier New", monospace;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
  }
}
</style>
<!-- HANDMADE_PIXEL_THEME_END -->
</head>
  <body>
    <div id="fullscreenGate" class="fullscreen-gate">
      <div class="gate-content">
        <div class="gate-title">KEEP GRINDING<br />AND NOBODY DIES</div>
        <button id="enterBtn" class="enter-btn" type="button">
          TAP TO BEGIN
        </button>
        <div class="gate-hint">Hand this device to the defuser</div>
      </div>
    </div>

    <div id="eventBanner" class="event-banner"></div>
    <div id="bsod" class="overlay bsod">
      <div class="face">:(</div>
      <h1>ESP32_FATAL_INTERFACE_ERROR</h1>
      <p>The module encountered a highly suspicious problem.</p>
      <p>Collecting bad decisions: <span id="bsodPercent">0</span>%</p>
    </div>
    <div id="jump" class="overlay jumpscare">
      <div class="monster">
        <div class="eye left"><div class="pupil"></div></div>
        <div class="eye right"><div class="pupil"></div></div>
        <div class="mouth" id="teeth"></div>
      </div>
    </div>
    <div id="jumpVideo" class="overlay jumpscare-video">
      <video id="jumpVideoEl" autoplay loop playsinline></video>
    </div>
    <div id="staticNoise" class="overlay static-noise">
      <span>SIGNAL LOST</span>
    </div>

    <div id="stimCorner" class="stim-corner">
      <div id="stimFeed" class="stim-feed"></div>
      <div class="stim-ui"><span>❤️</span><span>💬</span><span>↪️</span></div>
      <div class="stim-label">stim cam</div>
    </div>

    <div id="root" class="defuser">
      <div id="shell" class="casing">
        <header class="status-bar">
          <div id="timer" class="timer">3:00</div>
          <div id="strikes" class="strikes"></div>
          <div class="badges">
            <span class="badge">SERIAL · <span id="serial">------</span></span>
            <span class="badge">BATT · <span id="batteries">0</span></span>
            <span id="badgeCar" class="badge">IND · CAR</span>
            <span id="badgeFrk" class="badge">IND · FRK</span>
          </div>
        </header>

        <div id="statusLine" class="status-line">
          <div id="statusTitle" class="status-title"></div>
          <div id="statusDetail" class="status-detail"></div>
        </div>

        <main id="moduleGrid" class="module-grid"></main>

        <div id="waitingScreen" class="waiting-screen">
          <p>Waiting for bomb…</p>
        </div>
        <div id="resultScreen" class="result-screen"></div>
      </div>
    </div>

    <script>
      const teeth = document.getElementById("teeth");
      for (let i = 0; i < 14; i++)
        teeth.innerHTML += '<div class="tooth"></div>';

      const EVENT_LABELS = {
        Dyslexia: "D Y S L E X I A",
        UpsideDown: "UPSIDE DOWN",
        FakeBlueScreen: "SYSTEM ERROR",
        TurkAttack: "⚠ INTRUSION DETECTED",
        Jumpscare: "!!!",
        MirrorMode: "MIRROR MODE",
        StaticGlitch: "SIGNAL LOST",
        SirenLights: "🚨 ALERT 🚨",
      };

      let audioCtx = null;

      function getAudioContext() {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (AudioContextClass) audioCtx = new AudioContextClass();
        }
        return audioCtx;
      }

      // Synthesized on the fly (noise burst + a descending screech) so no
      // audio asset needs to be bundled/embedded.
      function playJumpscareSound() {
        const ctx = getAudioContext();
        if (!ctx) return;

        try {
          const now = ctx.currentTime;

          const bufferSize = Math.floor(ctx.sampleRate * 0.4);
          const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            data[i] = (Math.random() * 2 - 1) * Math.exp((-3 * i) / bufferSize);
          }
          const noise = ctx.createBufferSource();
          noise.buffer = buffer;
          const noiseGain = ctx.createGain();
          noiseGain.gain.setValueAtTime(0.9, now);
          noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
          noise.connect(noiseGain).connect(ctx.destination);
          noise.start(now);

          const osc = ctx.createOscillator();
          osc.type = "sawtooth";
          osc.frequency.setValueAtTime(1200, now);
          osc.frequency.exponentialRampToValueAtTime(80, now + 0.5);
          const oscGain = ctx.createGain();
          oscGain.gain.setValueAtTime(0.4, now);
          oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
          osc.connect(oscGain).connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.5);
        } catch (error) {
          console.error("Failed to play jumpscare sound:", error);
        }
      }

      document.getElementById("enterBtn").addEventListener("click", () => {
        // Creating the AudioContext here (inside a user-gesture handler)
        // satisfies browser autoplay policies so the jumpscare sound can
        // play later without another tap.
        getAudioContext();

        const el = document.documentElement;
        const request =
          el.requestFullscreen ||
          el.webkitRequestFullscreen ||
          el.msRequestFullscreen;
        if (request) {
          request.call(el).catch(() => {});
        }
        document.getElementById("fullscreenGate").classList.add("hidden");
        poll();
      });

      function fmt(ms) {
        const total = Math.max(0, Math.floor(ms / 1000));
        const m = String(Math.floor(total / 60)).padStart(2, "0");
        const s = String(total % 60).padStart(2, "0");
        return `${m}:${s}`;
      }

      function scrambleText(root) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);
        nodes.forEach((node) => {
          const text = node.nodeValue;
          if (!text || text.trim().length < 4) return;
          const chars = text.split("");
          for (let i = 1; i < chars.length - 1; i++) {
            if (/[A-Za-z]/.test(chars[i]) && Math.random() < 0.12) {
              const next = Math.min(i + 1, chars.length - 1);
              const tmp = chars[i];
              chars[i] = chars[next];
              chars[next] = tmp;
            }
          }
          node.nodeValue = chars.join("");
        });
      }

      function moduleTitle(kind) {
        return (
          {
            Wires: "Alien Wires",
            Simon: "Simon Says",
            Memory: "Memory",
            Hold: "The Button",
          }[kind] || kind
        );
      }

      function renderWires(mod) {
        const wires = mod.wires
          .map(
            (w) => `
    <div class="wire-row ${w.cut ? "is-cut" : ""}">
      <span class="wire-index">${w.index + 1}</span>
      <span class="wire"><span class="wire-line"></span>${w.cut ? '<span class="wire-gap"></span>' : ""}</span>
      <span class="wire-status">${w.cut ? "CUT" : "INTACT"}</span>
    </div>`,
          )
          .join("");

        const alien = mod.armed
          ? `<div class="alien-box">
        <div class="alien-phrase">${mod.alien_phrase}</div>
        <div class="alien-class">${mod.alien_class} CLASS · ${mod.alien_grammar}</div>
      </div>`
          : "";

        return `<div class="wire-list">
    <div class="wire-armed ${mod.armed ? "is-armed" : ""}">${mod.armed ? "ARMED — cut the correct wire" : "Reconnect every wire to arm"}</div>
    ${wires}
    ${alien}
  </div>`;
      }

      // Pads light from mod.lit — the engine's own playback state — so the
      // flashes the defuser sees are exactly the ones the engine is timing,
      // and the WATCH/YOUR TURN label flips exactly when input opens.
      function renderSimon(mod) {
        const colors = ["red", "blue", "green", "yellow"];
        const pads = colors
          .map(
            (c) =>
              `<span class="simon-pad ${c} ${mod.lit === c ? "is-lit" : ""}"></span>`,
          )
          .join("");
        const pips = mod.flash_sequence
          .map(
            (_, i) =>
              `<span class="pip ${i < mod.input_len ? "is-done" : ""}"></span>`,
          )
          .join("");
        const phase =
          mod.mode === "input"
            ? '<div class="simon-phase is-input">Your turn — repeat it</div>'
            : '<div class="simon-phase">Watch the sequence…</div>';
        return `<div class="simon">${phase}<div class="simon-pads">${pads}</div><div class="simon-progress">${pips}</div></div>`;
      }

      function renderMemory(mod) {
        // Stage progress as 5 punched dots (the pixel theme hides text in
        // .memory-stage); mod.stage can briefly be 6 while the solved
        // transition plays, which simply renders as "all five done".
        const stageDots = Array.from({ length: 5 }, (_, i) => {
          const stageClass =
            i < mod.stage - 1
              ? "is-done"
              : i === mod.stage - 1
                ? "is-current"
                : "";
          return `<span class="memory-stage-dot ${stageClass}"></span>`;
        }).join("");
        const slots = mod.labels
          .map(
            (label, i) => `
    <div class="memory-slot">
      <span class="memory-slot-index">POS ${i + 1}</span>
      <span class="memory-slot-label">${label}</span>
    </div>`,
          )
          .join("");
        return `<div class="memory">
    <div class="memory-stage" aria-label="Memory stage ${Math.min(mod.stage, 5)} of 5">${stageDots}</div>
    <div class="memory-display">${mod.display}</div>
    <div class="memory-slots">${slots}</div>
  </div>`;
      }

      function renderHold(mod) {
        const strip = mod.strip_visible
          ? `<div class="hold-strip ${mod.strip_color}">STRIP · ${mod.strip_color.toUpperCase()}</div>`
          : "";
        return `<div class="hold">
    <div class="hold-slot-indicator">ACTIVE BUTTON · POS ${mod.active_slot + 1}</div>
    <button type="button" class="hold-btn ${mod.color} ${mod.holding ? "is-holding" : ""}" disabled>${mod.label.toUpperCase()}</button>
    <div class="hold-status">${mod.holding ? "HOLDING…" : "release to arm"}</div>
    ${strip}
  </div>`;
      }

      function renderModule(mod, index) {
        let body;
        switch (mod.kind) {
          case "Wires":
            body = renderWires(mod);
            break;
          case "Simon":
            body = renderSimon(mod);
            break;
          case "Memory":
            body = renderMemory(mod);
            break;
          case "Hold":
            body = renderHold(mod);
            break;
          default:
            body = "";
        }

        return `<section class="module-card ${mod.solved ? "is-solved" : ""}">
    <header class="module-head">
      <span class="module-title">${moduleTitle(mod.kind)}</span>
      <span class="module-status">${mod.solved ? "✓ SOLVED" : "ARMED"}</span>
    </header>
    <div class="module-body">${body}</div>
  </section>`;
      }

      let latestView = null;
      let lastEventKind = null;

      // ---- Stimulation corner ------------------------------------------
      // Builds the muted vertical feed once per set of configured clips,
      // then auto-"swipes" to the next one every 12s. Only the on-screen
      // clip plays; the rest stay paused. Everything is muted, both for
      // browser autoplay policy and so it can't talk over the game.
      const STIM_SWIPE_MS = 12000;
      let stimUrlsKey = null;
      let stimIndex = 0;
      let stimTimer = null;

      function setupStimFeed(urls) {
        const feed = document.getElementById("stimFeed");
        clearInterval(stimTimer);
        stimTimer = null;
        stimIndex = 0;
        feed.innerHTML = "";
        feed.style.transform = "";

        urls.forEach((url) => {
          const video = document.createElement("video");
          video.src = url;
          video.muted = true;
          video.loop = true;
          video.playsInline = true;
          video.setAttribute("playsinline", "");
          feed.appendChild(video);
        });

        if (urls.length > 1) {
          stimTimer = setInterval(() => {
            stimIndex = (stimIndex + 1) % urls.length;
            feed.style.transform = `translateY(-${stimIndex * 100}%)`;
            syncStimPlayback();
          }, STIM_SWIPE_MS);
        }
      }

      function syncStimPlayback() {
        const corner = document.getElementById("stimCorner");
        const videos = document.getElementById("stimFeed").children;
        const visible = corner.classList.contains("show");
        for (let i = 0; i < videos.length; i++) {
          if (visible && i === stimIndex) {
            videos[i].play().catch(() => {});
          } else {
            videos[i].pause();
          }
        }
      }

      function updateStimCorner(view) {
        const corner = document.getElementById("stimCorner");
        const urls = view && view.stim_video_urls ? view.stim_video_urls : [];
        const key = urls.join(",");

        if (key !== stimUrlsKey) {
          stimUrlsKey = key;
          setupStimFeed(urls);
        }

        // Running games only - idle/result screens deserve full attention,
        // and event overlays (BSOD, jumpscare) sit above it anyway.
        const show = urls.length > 0 && view && view.phase === "Running";
        corner.classList.toggle("show", show);
        syncStimPlayback();
      }

      function renderAll() {
        const view = latestView;
        updateStimCorner(view);
        const shell = document.getElementById("shell");
        const waitingScreen = document.getElementById("waitingScreen");
        const resultScreen = document.getElementById("resultScreen");
        const moduleGrid = document.getElementById("moduleGrid");
        const statusBar = document.querySelector(".status-bar");

        shell.classList.remove("upside", "turk", "dyslexia", "mirror", "siren");
        document.getElementById("eventBanner").classList.remove("show");
        document.getElementById("bsod").classList.remove("show");
        document.getElementById("jump").classList.remove("show");
        document.getElementById("jumpVideo").classList.remove("show");
        document.getElementById("staticNoise").classList.remove("show");

        const statusLine = document.getElementById("statusLine");
        statusLine.classList.remove("show", "is-alert", "is-good");

        if (!view || typeof view.phase !== "string") {
          statusBar.style.display = "none";
          moduleGrid.style.display = "none";
          waitingScreen.classList.add("show");
          resultScreen.classList.remove("show");
          return;
        }

        document.getElementById("timer").textContent = fmt(view.timer_ms);
        document
          .getElementById("timer")
          .classList.toggle("is-low", view.timer_ms <= 30000);
        document.getElementById("serial").textContent = view.serial;
        document.getElementById("batteries").textContent = view.batteries;
        document
          .getElementById("badgeCar")
          .classList.toggle("is-lit", view.car);
        document
          .getElementById("badgeFrk")
          .classList.toggle("is-lit", view.frk);

        const strikes = document.getElementById("strikes");
        strikes.innerHTML = "";
        for (let i = 0; i < view.max_strikes; i++) {
          const span = document.createElement("span");
          span.className = `strike ${i < view.strikes ? "is-hit" : ""}`;
          span.textContent = "✕";
          strikes.appendChild(span);
        }

        if (view.phase === "Idle") {
          statusBar.style.display = "";
          moduleGrid.style.display = "none";
          waitingScreen.classList.add("show");
          resultScreen.classList.remove("show");
          return;
        }
        waitingScreen.classList.remove("show");

        if (view.phase === "Defused" || view.phase === "Exploded") {
          statusBar.style.display = "";
          moduleGrid.style.display = "none";
          resultScreen.classList.add("show");
          resultScreen.className = `result-screen show ${view.phase === "Defused" ? "defused" : "exploded"}`;
          resultScreen.innerHTML =
            view.phase === "Defused"
              ? `<div class="result-title">DEFUSED</div><div class="result-detail">All four modules solved with ${fmt(view.timer_ms)} remaining.</div>`
              : `<div class="result-title">BOOM</div><div class="result-detail">${view.status_detail || "Ran out of attempts or time expired."}</div>`;
          return;
        }
        resultScreen.classList.remove("show");
        statusBar.style.display = "";
        moduleGrid.style.display = "";

        // Engine feedback line — the only place mistakes get explained
        // ("SECOND CHANCE — Wrong alien wire | 20 seconds removed"), and
        // where an operator pause is announced so the defuser isn't left
        // wondering why the bomb stopped responding.
        document.getElementById("statusTitle").textContent = view.status_title;
        document.getElementById("statusDetail").textContent = view.status_detail;
        statusLine.classList.add("show");
        if (view.paused) {
          statusLine.classList.add("is-alert");
        } else if (view.status_title === "SECOND CHANCE") {
          statusLine.classList.add("is-alert");
        } else if (
          view.status_title === "MODULE SOLVED" ||
          view.status_title === "SIMON CORRECT"
        ) {
          statusLine.classList.add("is-good");
        }

        // Only one module is ever actually being played at a time - modules not
        // yet reached still hold placeholder/default data, so show a compact
        // progress stepper plus just the active module rather than all 4 at once.
        const stepper = view.modules
          .map((mod, i) => {
            const stateClass = mod.solved
              ? "step-done"
              : i === view.active_module_index
                ? "step-current"
                : "";
            return `<div class="step ${stateClass}">
      <span class="step-dot">${mod.solved ? "✓" : i + 1}</span>
      <span class="step-label">${moduleTitle(mod.kind).split(" ")[0]}</span>
    </div>`;
          })
          .join("");

        const activeModule =
          view.active_module_index !== null
            ? view.modules[view.active_module_index]
            : null;
        moduleGrid.innerHTML =
          `<div class="module-stepper">${stepper}</div>` +
          (activeModule
            ? renderModule(activeModule, view.active_module_index)
            : "");

        const event = view.active_event;
        if (event) {
          const banner = document.getElementById("eventBanner");
          banner.textContent = EVENT_LABELS[event.kind] || event.kind;
          banner.classList.add("show");

          if (event.kind === "Dyslexia") {
            shell.classList.add("dyslexia");
            scrambleText(moduleGrid);
          }
          if (event.kind === "UpsideDown") shell.classList.add("upside");
          if (event.kind === "TurkAttack") shell.classList.add("turk");
          if (event.kind === "MirrorMode") shell.classList.add("mirror");
          if (event.kind === "SirenLights") shell.classList.add("siren");
          if (event.kind === "FakeBlueScreen") {
            document.getElementById("bsod").classList.add("show");
            // BlueScreen's total duration is 9000ms (src-tauri/src/engine/events.rs)
            document.getElementById("bsodPercent").textContent = Math.max(
              0,
              Math.min(100, Math.floor((9000 - event.remaining_ms) / 90)),
            );
          }
          if (event.kind === "Jumpscare") {
            const isNewJumpscare = lastEventKind !== "Jumpscare";

            if (event.video_url) {
              const videoEl = document.getElementById("jumpVideoEl");
              if (isNewJumpscare) {
                videoEl.src = event.video_url;
                videoEl.currentTime = 0;
                videoEl.play().catch(() => {});
              }
              document.getElementById("jumpVideo").classList.add("show");
            } else {
              document.getElementById("jump").classList.add("show");
              if (isNewJumpscare) playJumpscareSound();
            }
          }
          if (event.kind === "StaticGlitch")
            document.getElementById("staticNoise").classList.add("show");
        }
        lastEventKind = event ? event.kind : null;
      }

      async function poll() {
        try {
          const response = await fetch(`/state?t=${Date.now()}`, {
            cache: "no-store",
          });
          latestView = await response.json();
        } catch (error) {
          // Keep showing the last good view; a transient fetch failure isn't
          // worth flashing the "waiting" screen over. Logged so a persistent
          // failure is at least visible in devtools instead of silent.
          console.error("Failed to poll /state:", error);
        }
        renderAll();
        // 100ms keeps Simon's engine-driven flashes (480ms on / 280ms off)
        // feeling immediate rather than laggy.
        setTimeout(poll, 100);
      }
    </script>
  </body>
