import { useEffect, useState, type ReactNode } from "react";
import type { ModuleState } from "../types";

type Tab = ModuleState["kind"];
const TABS: Tab[] = ["Memory", "Simon", "Hold", "Wires"];

const TAB_TITLES: Record<Tab, string> = {
  Memory: "Memory",
  Simon: "Color Memory",
  Hold: "The Button",
  Wires: "Alien Wires",
};

interface ManualProps {
  activeKind: Tab | null;
  holdThresholdMs: number;
  simonMaxStages: number;
}

export function Manual({
  activeKind,
  holdThresholdMs,
}: ManualProps) {
  const [tab, setTab] = useState<Tab>(activeKind ?? "Memory");

  useEffect(() => {
    if (activeKind) setTab(activeKind);
  }, [activeKind]);

  return (
    <div className="manual-panel">
      <nav className="manual-tabs">
        {TABS.map((t) => (
          <button
            key={t}
            type="button"
            className={`manual-tab ${tab === t ? "is-active" : ""} ${
              activeKind === t ? "is-live" : ""
            }`}
            onClick={() => setTab(t)}
          >
            {TAB_TITLES[t]}
            {activeKind === t ? " •" : ""}
          </button>
        ))}
      </nav>

      <div className="manual-body">
        {tab === "Memory" && <MemoryManual />}
        {tab === "Simon" && <ColorMemoryManual />}
        {tab === "Hold" && (
          <ButtonManual holdThresholdMs={holdThresholdMs} />
        )}
        {tab === "Wires" && <WiresManual />}
      </div>
    </div>
  );
}

function Example({ children }: { children: ReactNode }) {
  return (
    <div className="manual-example">
      <div className="manual-example-label">EXAMPLE</div>
      {children}
    </div>
  );
}

/*
 * The numeric Memory module is unchanged.
 * "Memory color game" refers to the Simon/Color Memory module below.
 */
