          </tr>
        </thead>
        <tbody>
          <tr><td rowSpan={3}>1</td><td>1 or 2</td><td>Position 2</td></tr>
          <tr><td>3</td><td>Position 3</td></tr>
          <tr><td>4</td><td>Position 4</td></tr>

          <tr><td rowSpan={3}>2</td><td>1</td><td>The current button labelled 4</td></tr>
          <tr><td>2 or 4</td><td>Same position as Stage 1</td></tr>
          <tr><td>3</td><td>Position 1</td></tr>

          <tr><td rowSpan={4}>3</td><td>1</td><td>The current label pressed in Stage 2</td></tr>
          <tr><td>2</td><td>The current label pressed in Stage 1</td></tr>
          <tr><td>3</td><td>Position 3</td></tr>
          <tr><td>4</td><td>The current button labelled 4</td></tr>

          <tr><td rowSpan={3}>4</td><td>1</td><td>Same position as Stage 1</td></tr>
