function ColorMemoryManual() {
  return (
    <div className="manual-section">
      <p className="manual-intro">
        The bomb flashes exactly <strong>three colors</strong>. The defuser
        repeats those same colors in the same order. There are no serial-number,
        strike, or translation rules.
      </p>

      <table className="manual-table">
        <thead>
          <tr>
            <th>Color shown</th>
            <th>Physical button</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>RED</td><td>Button 1</td></tr>
          <tr><td>BLUE</td><td>Button 2</td></tr>
          <tr><td>GREEN</td><td>Button 3</td></tr>
          <tr><td>YELLOW</td><td>Button 4</td></tr>
        </tbody>
      </table>

      <Example>
        RED, YELLOW, BLUE → press <strong>1, 4, 2</strong>.
      </Example>
    </div>
  );
}

function ButtonManual({
  holdThresholdMs,
}: {
  holdThresholdMs: number;
}) {
  const thresholdSeconds = (holdThresholdMs / 1000).toFixed(1);

  return (
    <div className="manual-section">
      <p className="manual-intro">
        The screen identifies one physical button and gives one instruction:
        <strong> TAP</strong> or <strong>HOLD</strong>.
      </p>

      <ul className="manual-list">
        <li>
          <strong>TAP</strong> → press and release in under approximately{" "}
          {thresholdSeconds} seconds.
        </li>
        <li>
          <strong>HOLD</strong> → keep holding until the screen says{" "}
          <strong>READY — RELEASE NOW</strong>, then release.
        </li>
      </ul>

      <p className="manual-note">
        Batteries, CAR, FRK, button text, strip colors, and timer digits are no
        longer part of this module.
      </p>
    </div>
  );
}

function WiresManual() {
  return (
    <div className="manual-section">
      <p className="manual-intro">
        The physical wires are now named by color, in this fixed order:
        <strong> BLUE → WHITE → BLACK → YELLOW</strong>.
      </p>

      <table className="manual-table">
        <thead>
          <tr>
            <th>Wire color</th>
            <th>Alien index words</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>BLUE</td><td>KEL, PLO, ESH</td></tr>
          <tr><td>WHITE</td><td>DRA, RIM, GRA</td></tr>
          <tr><td>BLACK</td><td>VON, TAK, NOL</td></tr>
          <tr><td>YELLOW</td><td>SEK, WU, FEX</td></tr>
        </tbody>
      </table>

      <p className="manual-note">
        Decode the clue color, then apply the class:
      </p>

      <ul className="manual-list">
        <li><strong>ALPHA</strong> → cut the decoded color.</li>
        <li>
          <strong>BETA</strong> → cut the next color in the order
          BLUE → WHITE → BLACK → YELLOW → BLUE.
        </li>
        <li>
          <strong>OMEGA</strong> → cut the opposite color:
          BLUE ↔ BLACK and WHITE ↔ YELLOW.
        </li>
      </ul>

      <Example>
        DRA means WHITE. BETA means the next color, so cut{" "}
        <strong>BLACK</strong>.
      </Example>
    </div>
  );
}
