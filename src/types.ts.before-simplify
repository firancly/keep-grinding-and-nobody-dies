// Shared protocol types — these mirror the Rust `DefuserView` serde structs
// in src-tauri/src/view.rs exactly.
export interface DefuserView {
  phase: "Idle" | "Running" | "Defused" | "Exploded";
  timer_ms: number;
  strikes: number;
  max_strikes: number;
  serial: string;
  batteries: number;
  car: boolean;
  frk: boolean;
  modules: ModuleState[];
  active_event: EventInfo | null;
  active_module_index: number | null;
  hold_threshold_ms: number;
  simon_max_stages: number;
  status_title: string;
  status_detail: string;
}

export type ModuleState =
  | WiresModule
  | SimonModule
  | MemoryModule
  | HoldModule;

export interface WireSlot {
  // Internal physical order:
  // 0 BLUE, 1 WHITE, 2 BLACK, 3 YELLOW.
  index: number;
  cut: boolean;
}

export interface WiresModule {
  kind: "Wires";
  wires: [WireSlot, WireSlot, WireSlot, WireSlot];
  armed: boolean;
  alien_phrase: string;
  alien_class: "ALPHA" | "BETA" | "OMEGA";
  alien_grammar: string;
  alien_action: string;
  alien_noun: string;
  alien_ordinals: [string, string, string, string];
  solved: boolean;
}

export type SimonColor = "red" | "blue" | "green" | "yellow";

export interface SimonModule {
  kind: "Simon";
  flash_sequence: SimonColor[];
  input_len: number;
  mode: "watch" | "input";
  lit: SimonColor | null;
  solved: boolean;
}

export interface MemoryModule {
  kind: "Memory";
  stage: number;
  display: number;
  labels: [number, number, number, number];
  solved: boolean;
}

export type ButtonColor = "blue" | "white" | "yellow" | "red";
export type ButtonLabel = "tap" | "hold";
export type StripColor = "blue" | "white" | "yellow" | "red";

export interface HoldModule {
  kind: "Hold";
  color: ButtonColor;
  label: ButtonLabel;
  active_slot: number;
  holding: boolean;
  // In the simplified module this means "READY to release".
  strip_visible: boolean;
  strip_color: StripColor | null;
  solved: boolean;
}

export type EventKind =
  | "Dyslexia"
  | "UpsideDown"
  | "FakeBlueScreen"
  | "TurkAttack"
  | "Jumpscare"
  | "MirrorMode"
  | "StaticGlitch"
  | "SirenLights";

export interface EventInfo {
  kind: EventKind;
  remaining_ms: number;
  video_url: string | null;
}
